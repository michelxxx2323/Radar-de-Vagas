# Copie este arquivo para ".env" (ou exporte a variável no terminal) e cole sua chave.
# Chave obtida em https://console.typesafe.ai/keys (acesso via early access / lista de espera).
TYPESAFE_API_KEY=

# Painel na nuvem (sincronizar.py). PAINEL_URL = endereço do projeto na Vercel;
# PAINEL_TOKEN = o mesmo valor cadastrado lá nas variáveis de ambiente.
PAINEL_URL=
PAINEL_TOKEN=
